# Backend
PORT=3000
CONTENT_PATH=./content
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://your_db_user:your_strong_password_here@localhost:5432/velaluna

# Docker Compose (voir .env.docker pour le template complet)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=velaluna
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password_here

# Frontend (prefixed VITE_ pour être exposées au client)
VITE_API_BACKEND_URL=http://localhost:3000
