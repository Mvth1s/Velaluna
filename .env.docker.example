# Copier vers .env.docker et remplir les vraies valeurs — NE JAMAIS COMMITER .env.docker

POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=velaluna
DATABASE_URL=postgresql://your_db_user:your_strong_password_here@db:5432/velaluna
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password_here
